# ------------------------------------------------------------------
# Nexora WhatsApp Hub — environment template
# Copy to .env and adjust. NEVER commit real .env files.
# ------------------------------------------------------------------

# --- Database (PostgreSQL) ---
# Used by docker-compose and embedded dev Postgres.
DATABASE_URL="postgresql://nexora:nexora_dev_password@localhost:5432/nexora?schema=public"

# --- Redis (optional) ---
# If empty, realtime coordination and background jobs degrade to
# an in-memory implementation (single-process dev mode).
REDIS_URL=""

# --- API ---
PORT=4000
NODE_ENV=development
API_CORS_ORIGIN="http://localhost:3000"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-64-char-random-hex-secret"
JWT_EXPIRES_IN="7d"
SESSION_TTL_SECONDS=604800

# --- Security ---
# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Trust proxy (set to 1 when behind the docker-compose proxy)
TRUST_PROXY=0

# --- Seed / demo ---
DEMO_ADMIN_EMAIL="admin@nexora.local"
DEMO_ADMIN_PASSWORD="NexoraDev123!"